# Example env file for local reference only.
# These values are set by render.yaml on Render — you do not need this file
# to deploy. It's included so you can sanity-check what the deployed
# firecrawl-api service receives.

# ===== Auto-wired by render.yaml =====
PORT=3002
HOST=0.0.0.0
USE_DB_AUTHENTICATION=false
LOGGING_LEVEL=info

# Worker concurrency (lowered from upstream defaults to fit a 4 GB plan).
NUQ_WORKER_COUNT=2
NUM_WORKERS_PER_QUEUE=4
CRAWL_CONCURRENT_REQUESTS=5
MAX_CONCURRENT_JOBS=3
BROWSER_POOL_SIZE=3
MAX_CPU=0.8
MAX_RAM=0.8

# Private-network endpoints (Render resolves these via internal DNS).
PLAYWRIGHT_MICROSERVICE_URL=http://firecrawl-playwright:3000/scrape
NUQ_RABBITMQ_URL=amqp://firecrawl-rabbitmq:5672
POSTGRES_HOST=firecrawl-postgres
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=firecrawl
# POSTGRES_PASSWORD is generateValue: true; set in dashboard.
# REDIS_URL / REDIS_RATE_LIMIT_URL come from the Key Value service.

# BULL_AUTH_KEY is generateValue: true; set in dashboard.

# ===== Optional secrets (sync: false; set in dashboard) =====
# OPENAI_API_KEY=
# PROXY_SERVER=
# PROXY_USERNAME=
# PROXY_PASSWORD=
# SEARXNG_ENDPOINT=
